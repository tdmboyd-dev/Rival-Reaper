# Local only. Copy to private/higgsfield.env and paste the complete KEY_ID:KEY_SECRET value from Higgsfield.
# Never commit the filled file or paste the secret into chat.
HF_CREDENTIALS=

# Publicly reachable reference-image URLs used by Higgsfield API.
# After the approved prompt-pack PNGs are uploaded to the repo or another approved host, paste their URLs here.
REAPER_MACHINE_URL=
FIELD_DAY_MASTER_URL=
RIVAL_REAPER_LOGO_URL=
CONTROL_ROOM_REFERENCE_URL=
